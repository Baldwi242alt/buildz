# Hosted deployment: use a non-owner buildz_api login, never postgres/service_role.
NODE_ENV=development
PORT=3001
# Direct/local default. Set only after verifying the hosting proxy path.
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://buildz_api:CHANGE_ME@127.0.0.1:5432/postgres
# Used only by migration/bootstrap scripts, never by the API.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres
DATABASE_SSL=false
AUTH_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
AUTH_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
AUTH_USERINFO_URL=https://YOUR_PROJECT.supabase.co/auth/v1/user
AUTH_AUDIENCE=authenticated
AUTH_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_ORIGIN=http://localhost:3000
# Worker must use a separate buildz_worker credential.
WORKER_DATABASE_URL=postgresql://buildz_worker:CHANGE_ME@127.0.0.1:5432/postgres
