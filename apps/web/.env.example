# Public build-time values. Never put service-role keys or database credentials here.
VITE_BUILDZ_API_BASE_URL=
VITE_BUILDZ_AUTH_URL=
VITE_BUILDZ_AUTH_PUBLISHABLE_KEY=
VITE_BUILDZ_LOCAL_DEMO=false
# Preview is an explicit user choice and exists only in the development build.
# To use the fictional, connected local backend:
# VITE_BUILDZ_API_BASE_URL=http://127.0.0.1:3001/v1
# VITE_BUILDZ_LOCAL_DEMO=true
# Run npm run dev:backend in a separate terminal. Never enable this for a hosted service.
